# RecoverAI Configuration
# Copy this to .env and fill in your values

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
RECOVERAI_GEMINI_API_KEY=your_gemini_api_key_here

# Database (default: SQLite)
RECOVERAI_DATABASE_URL=sqlite:///./recoverai.db

# Gemini Model
RECOVERAI_GEMINI_MODEL=gemini-3.5-flash

# Maximum LLM calls per batch to prevent rate-limit starvation (0 = unlimited)
RECOVERAI_AI_BATCH_LIMIT=50

# Policy Thresholds (all amounts in paise, 100 paise = 1 INR)
RECOVERAI_MAX_RETRIES=3
RECOVERAI_HIGH_VALUE_THRESHOLD=5000000
RECOVERAI_CONFIDENCE_THRESHOLD=0.6
RECOVERAI_CUSTOMER_FAILURE_LIMIT=5
RECOVERAI_MAX_AUTO_RECOVERY_AMOUNT=10000000

# CORS (comma-separated origins)
RECOVERAI_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
